PORT=4000
DIFFICULTY=4
# Orígenes permitidos (separados por coma). Use * en producción para permitir Vercel y previews.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Consulta DNI (obligatorio para verificación con cualquier DNI)
# Registro gratuito: https://apiperu.dev — proveedor por defecto (nombre, padrón SUNAT)
# Para validar fecha de nacimiento use apidni.com y DNI_API_PROVIDER=apidni
DNI_API_TOKEN=
DNI_API_PROVIDER=apiperu
